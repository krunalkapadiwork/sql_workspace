# Application
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/sql_workspace_dev

# Redis (Caching, Rate Limiting, BullMQ)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_ACCESS_SECRET=your-super-secret-jwt-access-token-key-minimum-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
INVITE_TTL_HOURS=48
RESET_TTL_MINUTES=60
BCRYPT_ROUNDS=12

# Super Admin Initial Credentials (BR-2, BR-3)
SUPER_ADMIN_EMAIL=superadmin@sqlworkspace.com
SUPER_ADMIN_PASSWORD=SuperAdmin@Secure123!

# Email (SMTP / Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@sqlworkspace.com

